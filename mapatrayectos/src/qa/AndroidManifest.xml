<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- QA merges Android system permissions from main. Production receivers,
         services, content providers and launchers MUST NOT be packaged. -->
    <application
        tools:node="replace"
        android:allowBackup="false"
        android:debuggable="false"
        android:usesCleartextTraffic="false"
        android:label="Mapa QT Live QA"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:theme="@style/AppTheme">
        <activity
            android:name="uy.com.mapatrayectos.qa.LiveQaActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name="uy.com.mapatrayectos.qa.LiveQaTrackingService"
            android:exported="false"
            android:foregroundServiceType="location"/>
    </application>
</manifest>
